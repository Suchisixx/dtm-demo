        <mxCell id="dt_upgrade" value="Áp dụng quy tắc nâng nhóm:
Nhóm III -&gt; Nhóm II | Nhóm II -&gt; Nhóm I" style="shape=rect;rounded=1;fillColor=#FFFBEB;strokeColor=#D97706;fontStyle=1;fontColor=#B45309;" vertex="1" parent="1">
          <mxGeometry x="670" y="395" width="230" height="50" as="geometry" />
        </mxCell>
        <mxCell id="dt_dossier" value="Xác định loại hồ sơ môi trường:
• Nhóm I &amp; II: Báo cáo ĐTM &amp; Giấy phép GPMT
• Nhóm III: Giấy phép GPMT / Đăng ký ĐKMT
• Nhóm IV: Đăng ký môi trường ĐKMT" style="shape=rect;rounded=1;fillColor=#ECFDF5;strokeColor=#059669;strokeWidth=1.5;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="320" y="510" width="280" height="75" as="geometry" />
