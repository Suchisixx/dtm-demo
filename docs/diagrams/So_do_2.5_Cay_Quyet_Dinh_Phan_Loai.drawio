          <mxGeometry x="320" y="280" width="280" height="55" as="geometry" />
        </mxCell>
        <mxCell id="dt_g2" value="Có yếu tố nhạy cảm môi trường?
(Ven biển, bảo tồn, rừng, xả thải lớn)" style="rhombus;fillColor=#FEF3C7;strokeColor=#D97706;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="350" y="375" width="220" height="90" as="geometry" />
