  <diagram id="sd28_reminder" name="Sơ đồ 2.8: Lưu đồ Tính hạn và phân mức cảnh báo nghĩa vụ môi trường">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="950" pageHeight="750" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t8" value="SƠ ĐỒ 2.8: LƯU ĐỒ TÍNH HẠN VÀ PHÂN MỨC CẢNH BÁO NGHĨA VỤ MÔI TRƯỜNG" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="100" y="20" width="750" height="35" as="geometry" />
        </mxCell>
        <mxCell id="rm_start" value="Bắt đầu: Tác vụ cron chạy ngầm định kỳ hàng ngày (00:00)
Đọc danh mục dự án &amp; nghĩa vụ định kỳ trong CSDL" style="ellipse;fillColor=#286B4F;strokeColor=#1E563F;fontStyle=1;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="300" y="70" width="340" height="55" as="geometry" />
        </mxCell>
        <mxCell id="rm_calc" value="Tính mốc thời hạn đến hạn tiếp theo (T_due)
và khoảng cách số ngày còn lại: Δt = T_due - T_hien_tai" style="shape=rect;rounded=1;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=1.5;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="310" y="165" width="320" height="55" as="geometry" />
        </mxCell>
        <mxCell id="rm_branch" value="Phân loại số ngày còn lại (Δt)?" style="rhombus;fillColor=#FEF3C7;strokeColor=#D97706;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="370" y="260" width="200" height="80" as="geometry" />
        </mxCell>
        <mxCell id="rm_danger" value="🔴 ĐÃ QUÁ HẠN (Δt &lt; 0)
Cảnh báo mức cao nhất" style="shape=rect;rounded=1;fillColor=#FEF2F2;strokeColor=#DC2626;fontColor=#DC2626;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="390" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="rm_warn" value="🟡 SẮP ĐẾN HẠN (0 &lt;= Δt &lt;= 15)
Nhắc nhở chuẩn bị nộp" style="shape=rect;rounded=1;fillColor=#FFFBEB;strokeColor=#D97706;fontColor=#B45309;fontStyle=1;" vertex="1" parent="1">
