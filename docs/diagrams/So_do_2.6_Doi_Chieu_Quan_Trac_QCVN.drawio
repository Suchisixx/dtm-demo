        <mxCell id="t6" value="SƠ ĐỒ 2.6: LƯU ĐỒ ĐỐI CHIẾU KẾT QUẢ QUAN TRẮC VỚI QCVN" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="100" y="20" width="750" height="35" as="geometry" />
        </mxCell>
        <mxCell id="q_start" value="Bắt đầu: Nhập kết quả mẫu đo
(Loại mẫu: Nước thải CN/SH, Khí thải; Lưu lượng)" style="ellipse;fillColor=#286B4F;strokeColor=#1E563F;fontStyle=1;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="310" y="70" width="320" height="55" as="geometry" />
        </mxCell>
        <mxCell id="q_select" value="Tự động chọn bộ quy chuẩn &amp; Cột áp dụng
(QCVN 40, 14, 19 theo Cột A hoặc Cột B)" style="shape=rect;rounded=1;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=1.5;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="330" y="160" width="280" height="55" as="geometry" />
        </mxCell>
        <mxCell id="q_gate" value="Đủ chỉ tiêu bắt buộc &amp;
Đúng chu kỳ lấy mẫu?" style="rhombus;fillColor=#FEF3C7;strokeColor=#D97706;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="370" y="250" width="200" height="80" as="geometry" />
        </mxCell>
        <mxCell id="q_err" value="DỪNG: Gán INCOMPLETE
(Khóa xuất báo cáo chính thức)" style="shape=rect;rounded=1;fillColor=#FEF2F2;strokeColor=#DC2626;fontColor=#DC2626;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="670" y="265" width="220" height="50" as="geometry" />
        </mxCell>
        <mxCell id="q_compare" value="So sánh từng thông số đo với ngưỡng quy chuẩn
(Ngưỡng Max, Min, và Khoảng giá trị pH)" style="shape=rect;rounded=1;fillColor=#F0FDF4;strokeColor=#16A34A;strokeWidth=1.5;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="320" y="370" width="300" height="55" as="geometry" />
        </mxCell>
        <mxCell id="q_branch" value="Đánh giá phân loại 3 mức trạng thái:
• 🔴 Vượt ngưỡng: Có ít nhất 1 thông số vượt chuẩn
• 🟡 Cảnh báo: Các chỉ tiêu đạt nhưng có chỉ tiêu &gt; 80% ngưỡng
• 🟢 Đạt chuẩn: 100% chỉ tiêu nằm trong giới hạn an toàn" style="shape=rect;rounded=1;fillColor=#F8FAFC;strokeColor=#286B4F;strokeWidth=2;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="300" y="465" width="340" height="85" as="geometry" />
