  <diagram id="sd26_qcvn_flow" name="Sơ đồ 2.6: Lưu đồ Đối chiếu kết quả quan trắc với QCVN">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="950" pageHeight="820" math="0" shadow="0">
      <root>
        <mxCell id="0" />
