  <diagram id="sd29_gis_spatial" name="Sơ đồ 2.9: Luồng truy vấn và hiển thị dữ liệu không gian GIS">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1050" pageHeight="600" math="0" shadow="0">
